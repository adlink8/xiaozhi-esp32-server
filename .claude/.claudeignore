# ============================================
# 依赖包 & 包管理缓存（体积大、变化频繁）
# ============================================
# Node.js (Vue/JS 前端)
node_modules/
.npm/
.pnpm-store/
.yarn/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Python (xiaozhi-server)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
ENV/

# Java (manager-api)
target/
.mvn/
mvnw
mvnw.cmd
*.class
*.jar
*.war

# ============================================
# 构建产物 & 临时文件（对代码理解无用）
# ============================================
# 通用构建输出
dist/
build/
out/
*.log

# Docker 镜像构建产物
*.tar
*.tar.gz

# ============================================
# IDE & 编辑器配置（个人配置，非逻辑代码）
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# Git & CI/CD（对理解业务逻辑帮助不大）
# ============================================
.git/
.github/
.gitlab/

# ============================================
# 文档与多语言 README（减少重复内容）
# ============================================
# 如果你只需要 Claude 读一个版本的 README，可以保留主 README
docs/
README_de.md
README_en.md
README_pt_BR.md
README_vi.md

# ============================================
# 日志、临时文件、测试覆盖率
# ============================================
logs/
*.log
tmp/
temp/
coverage/
.nyc_output/
*.gcda
*.gcno

# ============================================
# 数据库文件（如果有本地 SQLite 等）
# ============================================
*.db
*.sqlite
*.sqlite3

# ============================================
# 敏感信息（避免 AI 读到）
# ============================================
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12

# ============================================
# 大型二进制文件或媒体资源
# ============================================
*.bin
*.elf
*.map
*.mp3
*.wav
*.mp4
*.jpg
*.png
*.gif